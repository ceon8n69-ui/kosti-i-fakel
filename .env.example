# PostgreSQL (на Railway подставляется из плагина: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://kf:kf@localhost:5432/kf
# Для интеграционных тестов
TEST_DATABASE_URL=postgres://kf:kf@localhost:5432/kf_test

# Бот от @BotFather
BOT_TOKEN=
BOT_USERNAME=
# Короткое имя Mini App из @BotFather → /newapp
MINI_APP_SHORT_NAME=play
# webhook на Railway, polling локально (через pnpm dev:bot), off — бот не стартует в API
BOT_MODE=off
WEBHOOK_SECRET=

# Публичный https-адрес сервиса, напр. https://kosti-i-fakel.up.railway.app
PUBLIC_URL=

# Подпись сессионных токенов: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SEC=3600
AUTH_MAX_AGE_SEC=86400

PORT=3000
LOG_LEVEL=info
RUN_MIGRATIONS=true
