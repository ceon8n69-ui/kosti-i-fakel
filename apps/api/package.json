{
  "name": "@kf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.3.0",
    "@kf/bot": "workspace:*",
    "@kf/content": "workspace:*",
    "@kf/schema": "workspace:*",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.1",
    "postgres": "3.4.7",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.5"
  }
}
