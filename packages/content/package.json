{
  "name": "@kf/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./balance.json": "./balance.json"
  },
  "files": [
    "dist",
    "balance.json",
    "items.json",
    "biomes.json",
    "events.json",
    "dungeons"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kf/schema": "workspace:*"
  }
}